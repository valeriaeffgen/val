# Chaves da Val — copie para .env e preencha. Nunca comite o .env (segredos).

# Supabase (seção 9): auth, banco e caixa das cartas.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API da Anthropic (seção 7): a chave NÃO vai aqui no frontend. Ela é segredo
# da função Edge `conversar`. Configure com:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# (ver supabase/README.md). Esta linha fica só como lembrete — deixe vazia.
# ANTHROPIC_API_KEY=
